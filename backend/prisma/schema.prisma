generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum ChallengePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum CreditEntryType {
  TRIAL_GRANT
  SUBSCRIPTION_GRANT
  TOP_UP
  RESERVATION
  SETTLEMENT
  REFUND
  EXPIRATION
  ADMIN_ADJUSTMENT
}

enum ReservationStatus {
  RESERVED
  SETTLED
  REFUNDED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  QUEUED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum UploadStatus {
  PENDING
  READY
  CONSUMED
}

enum ProviderKind {
  MOCK
  VERTEX
}

model User {
  id              String                  @id @default(cuid())
  email           String                  @unique
  firstName       String
  lastName        String
  emailVerifiedAt DateTime?
  role            UserRole                @default(USER)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  password        PasswordCredential?
  oauthAccounts   OAuthAccount[]
  sessions        RefreshSession[]
  challenges      VerificationChallenge[]
  subscriptions   Subscription[]
  creditBuckets   CreditBucket[]
  creditEntries   CreditLedgerEntry[]
  reservations    CreditReservation[]
  uploads         Upload[]
  generations     Generation[]
  assets          Asset[]
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model VerificationChallenge {
  id         String           @id @default(cuid())
  userId     String
  purpose    ChallengePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model Plan {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  monthlyPriceCents Int
  yearlyPriceCents  Int
  monthlyCredits    Decimal        @db.Decimal(12, 2)
  active            Boolean        @default(true)
  subscriptions     Subscription[]
}

model Subscription {
  id                 String               @id @default(cuid())
  userId             String
  planId             String
  interval           BillingInterval
  status             SubscriptionStatus   @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan                 @relation(fields: [planId], references: [id])
  periods            SubscriptionPeriod[]

  @@index([userId, status])
}

model SubscriptionPeriod {
  id             String       @id @default(cuid())
  subscriptionId String
  startsAt       DateTime
  endsAt         DateTime
  grantedAt      DateTime?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, startsAt])
}

model CreditPack {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  priceCents Int
  credits    Decimal @db.Decimal(12, 2)
  active     Boolean @default(true)
}

model CreditBucket {
  id        String              @id @default(cuid())
  userId    String
  source    String
  total     Decimal             @db.Decimal(12, 2)
  remaining Decimal             @db.Decimal(12, 2)
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   CreditLedgerEntry[]

  @@index([userId, expiresAt, createdAt])
}

model CreditLedgerEntry {
  id          String          @id @default(cuid())
  userId      String
  bucketId    String?
  type        CreditEntryType
  amount      Decimal         @db.Decimal(12, 2)
  referenceId String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      CreditBucket?   @relation(fields: [bucketId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model CreditReservation {
  id          String            @id @default(cuid())
  userId      String
  amount      Decimal           @db.Decimal(12, 2)
  allocations Json
  status      ReservationStatus @default(RESERVED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation  Generation?
}

model ModelDefinition {
  id              String            @id @default(cuid())
  slug            String            @unique
  displayName     String
  mediaType       MediaType
  provider        ProviderKind
  providerModelId String
  active          Boolean           @default(true)
  capabilities    Json
  prices          GenerationPrice[]
  generations     Generation[]
}

model GenerationPrice {
  id         String          @id @default(cuid())
  modelId    String
  duration   Int?
  resolution String?
  unitCost   Decimal         @db.Decimal(12, 2)
  model      ModelDefinition @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, duration, resolution])
}

model Upload {
  id          String       @id @default(cuid())
  userId      String
  objectKey   String       @unique
  filename    String
  contentType String
  size        Int
  status      UploadStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]
  generationInputs GenerationInput[]
}

model Generation {
  id                String             @id @default(cuid())
  userId            String
  modelId           String
  uploadId          String?
  reservationId     String             @unique
  idempotencyKey    String
  mediaType         MediaType
  status            GenerationStatus   @default(QUEUED)
  prompt            String
  requestSnapshot   Json
  outputCount       Int                @default(1)
  providerErrorCode String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  model             ModelDefinition    @relation(fields: [modelId], references: [id])
  upload            Upload?            @relation(fields: [uploadId], references: [id])
  reservation       CreditReservation  @relation(fields: [reservationId], references: [id])
  operation         ProviderOperation?
  assets            Asset[]
  inputs            GenerationInput[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model GenerationInput {
  id           String     @id @default(cuid())
  generationId String
  uploadId     String
  position     Int
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  upload       Upload     @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([generationId, uploadId])
  @@index([generationId, position])
}

model ProviderOperation {
  id                  String     @id @default(cuid())
  generationId        String     @unique
  providerOperationId String?    @unique
  diagnostics         Json?
  generation          Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String     @id @default(cuid())
  userId       String
  generationId String
  mediaType    MediaType
  objectKey    String     @unique
  contentType  String
  byteSize     Int
  width        Int?
  height       Int?
  duration     Int?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([userId, mediaType, createdAt])
}
